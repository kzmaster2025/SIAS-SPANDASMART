rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Profil Sekolah: Publik dapat membaca informasi sekolah
    match /profil_sekolah/{docId} {
      allow read: if true;
      allow write: if isValidId(docId);
    }

    // Data Siswa: Publik dapat melihat data siswa/buku induk
    match /siswa/{siswaId} {
      allow read: if true;
      allow write: if isValidId(siswaId);
    }

    // Data Pendidik dan Tenaga Kependidikan (GTK): Publik dapat melihat profil guru
    match /guru/{guruId} {
      allow read: if true;
      allow write: if isValidId(guruId);
    }

    // Dokumen dan SK Sekolah
    match /dokumen/{docId} {
      allow read: if true;
      allow write: if isValidId(docId);
    }

    // Persuratan Resmi Tata Usaha
    match /surat/{suratId} {
      allow read: if true;
      allow write: if isValidId(suratId);
    }

    // Catatan Transaksi Keuangan
    match /transaksi/{trxId} {
      allow read: if true;
      allow write: if isValidId(trxId);
    }

    // Agenda dan Pengumuman
    match /agenda/{agendaId} {
      allow read: if true;
      allow write: if isValidId(agendaId);
    }

    // Menu Navigasi Kustom buatan Admin
    match /custom_menus/{menuId} {
      allow read: if true;
      allow write: if isValidId(menuId);
    }

    // Item Konten Video, Foto, Tautan Menu Kustom
    match /custom_items/{itemId} {
      allow read: if true;
      allow write: if isValidId(itemId);
    }
  }
}
